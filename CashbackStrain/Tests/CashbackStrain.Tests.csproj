<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>CashbackStrain.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/CashbackBehaviour.cs" Link="CashbackBehaviour.cs" />
    <Compile Include="../src/CashbackStrainMod.cs" Link="CashbackStrainMod.cs" />
    <Compile Include="../src/OrderedDelegateHooks.cs" Link="OrderedDelegateHooks.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>
  <!-- These checks compile production gameplay against tiny native API stubs. -->
  <Target Name="CheckGambonanzaRefs" />
</Project>
